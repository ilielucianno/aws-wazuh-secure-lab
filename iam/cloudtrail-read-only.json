{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListTrailBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::aws-cloudtrail-logs-<account-id>-<suffix>"
    },
    {
      "Sid": "ReadTrailLogs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::aws-cloudtrail-logs-<account-id>-<suffix>/*"
    }
  ]
}
